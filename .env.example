# Supabase (auth + file storage)
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Postgres via Supabase transaction pooler, as the restricted app_server role
DATABASE_URL=postgresql://app_server.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:6543/postgres

# Vercel Cron sends "Authorization: Bearer $CRON_SECRET"
CRON_SECRET=<random string>

# Tests only: a local Postgres superuser URL (integration tests create throwaway databases)
TEST_PG_ADMIN_URL=postgres://postgres@127.0.0.1:54329/postgres
